<Window x:Class="MW3ModManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MW3 Mod Manager"
        Icon="Assets/AppIcon.ico"
        Width="1000" Height="800" MinWidth="880" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="EndLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="24,18,24,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Style="{StaticResource Kicker}" Text="CALL OF DUTY: MODERN WARFARE 3" />
                <TextBlock Style="{StaticResource Title}" Text="Mod Manager" Margin="0,2,0,0" FontSize="22" />
                <TextBlock x:Name="GamePathText" Text="Looking for a Steam install..."
                           Style="{StaticResource Subtext}" Margin="0,4,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Change..." Click="Browse_Click" HorizontalAlignment="Right" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Ellipse x:Name="GameDot" Width="7" Height="7" Fill="{StaticResource Dim}"
                             VerticalAlignment="Center" />
                    <TextBlock x:Name="GameStateText" Text="Not detected"
                               Style="{StaticResource Subtext}" Margin="6,0,14,0" />
                    <Ellipse x:Name="RuntimeDot" Width="7" Height="7" Fill="{StaticResource Dim}"
                             VerticalAlignment="Center" />
                    <TextBlock x:Name="RuntimeStateText" Text="Runtime not installed"
                               Style="{StaticResource Subtext}" Margin="6,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource CardBg}" CornerRadius="8"
                Padding="6" Margin="24,0,24,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="10,0,4,0">
                    <TextBlock Text="Preset" Style="{StaticResource Subtext}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="PresetBox" Style="{StaticResource Dropdown}" Width="152"
                              VerticalAlignment="Center" SelectionChanged="PresetBox_SelectionChanged" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="NavAim" Content="Aim" Style="{StaticResource NavButton}" Click="Nav_Click" />
                    <Button x:Name="NavWeapon" Content="Weapon" Style="{StaticResource NavButton}" Click="Nav_Click" />
                    <Button x:Name="NavViewmodel" Content="Viewmodel" Style="{StaticResource NavButton}" Click="Nav_Click" />
                    <Button x:Name="NavCrosshair" Content="Crosshair" Style="{StaticResource NavButton}" Click="Nav_Click" />
                    <Button x:Name="NavScreen" Content="Screen" Style="{StaticResource NavButton}" Click="Nav_Click" />
                    <Button x:Name="NavSetup" Content="Setup" Style="{StaticResource NavButton}" Click="Nav_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2" Margin="24,0,24,0">

            <!-- Aim -->
            <ScrollViewer x:Name="PageAim" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <Grid x:Name="FovPanel">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DockPanel>
                                <CheckBox x:Name="EnabledSwitch" DockPanel.Dock="Right" Content="On"
                                          Style="{StaticResource Switch}" VerticalAlignment="Center"
                                          Checked="Options_Changed" Unchecked="Options_Changed" />
                                <StackPanel>
                                    <TextBlock Text="Field of view" Style="{StaticResource Section}" />
                                    <TextBlock Text="Overrides the game's 65 degree hipfire view."
                                               Style="{StaticResource Subtext}" Margin="0,3,0,0" />
                                </StackPanel>
                            </DockPanel>

                            <Grid Grid.Row="1" Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Hipfire" Style="{StaticResource Subtext}" VerticalAlignment="Center" />
                                <TextBlock x:Name="FovValueText" Grid.Column="1" Text="90&#176;"
                                           Style="{StaticResource Value}" MinWidth="76"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <Slider x:Name="FovSlider" Grid.Row="2" Minimum="40" Maximum="130"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    Style="{StaticResource Slider}" VerticalAlignment="Center"
                                    Margin="0,8,0,0" ValueChanged="FovSlider_ValueChanged" />
                            <DockPanel Grid.Row="3" Margin="0,2,0,0">
                                <TextBlock DockPanel.Dock="Right" Text="130" Style="{StaticResource EndLabel}" />
                                <TextBlock Text="40" Style="{StaticResource EndLabel}" />
                            </DockPanel>

                            <CheckBox x:Name="AffectedSwitch" Grid.Row="4" Margin="0,16,0,0"
                                      Content="Scale aiming FOV with your FOV"
                                      Style="{StaticResource Switch}"
                                      Checked="Options_Changed" Unchecked="Options_Changed" />

                            <TextBlock x:Name="AdsHint" Grid.Row="5" Margin="0,6,0,0"
                                       Style="{StaticResource Subtext}" />

                            <Border Grid.Row="6" Height="1" Background="{StaticResource CardBorder}"
                                    Margin="0,16,0,0" />

                            <StackPanel Grid.Row="7" Margin="0,16,0,0">
                                <DockPanel>
                                    <CheckBox x:Name="AimSwitch" DockPanel.Dock="Right" Content="On"
                                              Style="{StaticResource Switch}" VerticalAlignment="Center"
                                              Margin="14,0,0,0"
                                              Checked="Aim_Changed" Unchecked="Aim_Changed" />
                                    <TextBlock x:Name="AimValueText" DockPanel.Dock="Right" Text="110%"
                                               Style="{StaticResource Value}" MinWidth="60"
                                               VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Aiming zoom" Style="{StaticResource Subtext}" />
                                        <TextBlock Text="Off leaves each weapon's own zoom alone."
                                                   Style="{StaticResource Subtext}" Opacity="0.7" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>
                                <Slider x:Name="AimSlider" Minimum="100" Maximum="135"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        Style="{StaticResource Slider}" VerticalAlignment="Center"
                                        Margin="0,8,0,0" ValueChanged="AimSlider_ValueChanged" />
                                <DockPanel Margin="0,2,0,0">
                                    <TextBlock DockPanel.Dock="Right" Text="135%" Style="{StaticResource EndLabel}" />
                                    <TextBlock Text="100% = stock" Style="{StaticResource EndLabel}" />
                                </DockPanel>
                                <CheckBox x:Name="FlatSwitch" Margin="0,16,0,0"
                                          Content="Same zoom on every weapon"
                                          Style="{StaticResource Switch}"
                                          Checked="Options_Changed" Unchecked="Options_Changed" />
                                <TextBlock x:Name="AimHint" Margin="0,6,0,0" Style="{StaticResource Subtext}" />

                                <Border Background="#121517" CornerRadius="6" Padding="14,11" Margin="0,16,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Hipfire" Style="{StaticResource Subtext}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="HipText" Grid.Column="1" Text="90.0&#176;" Margin="10,0,0,0"
                                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Text="Aiming" Grid.Column="3" Style="{StaticResource Subtext}"
                                                   VerticalAlignment="Center" Margin="16,0,0,0" />
                                        <TextBlock x:Name="AdsText" Grid.Column="4" Text="55.4&#176;" Margin="10,0,0,0"
                                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Weapon -->
            <ScrollViewer x:Name="PageWeapon" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top">
                        <Grid x:Name="SpreadPanel">
                            <StackPanel>
                                <TextBlock Text="Accuracy" Style="{StaticResource Section}" />
                                <TextBlock Text="How tight the cone is, hipfire and aimed. The two are separate."
                                           Style="{StaticResource Subtext}" Margin="0,3,0,0" />

                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Hipfire cone" Style="{StaticResource Subtext}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="SpreadValueText" Grid.Column="1" Text="0%"
                                               Style="{StaticResource Value}" MinWidth="76" />
                                </Grid>
                                <Slider x:Name="SpreadSlider" Minimum="0" Maximum="100"
                                        TickFrequency="5" IsSnapToTickEnabled="True"
                                        Style="{StaticResource Slider}" VerticalAlignment="Center"
                                        ValueChanged="SpreadSlider_ValueChanged" />
                                <DockPanel Margin="0,2,0,0">
                                    <TextBlock DockPanel.Dock="Right" Text="Every shot centred" Style="{StaticResource EndLabel}" />
                                    <TextBlock Text="Stock" Style="{StaticResource EndLabel}" />
                                </DockPanel>
                                <TextBlock x:Name="SpreadHint" Margin="0,10,0,0" Style="{StaticResource Subtext}" />

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Aim cone" Style="{StaticResource Subtext}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="SpreadAimValueText" Grid.Column="1" Text="0%"
                                               Style="{StaticResource Value}" MinWidth="76" />
                                </Grid>
                                <Slider x:Name="SpreadAimSlider" Minimum="0" Maximum="100"
                                        TickFrequency="5" IsSnapToTickEnabled="True"
                                        Style="{StaticResource Slider}" VerticalAlignment="Center"
                                        ValueChanged="SpreadAimSlider_ValueChanged" />
                                <DockPanel Margin="0,2,0,0">
                                    <TextBlock DockPanel.Dock="Right" Text="Every shot through the sight" Style="{StaticResource EndLabel}" />
                                    <TextBlock Text="Stock" Style="{StaticResource EndLabel}" />
                                </DockPanel>
                                <TextBlock x:Name="SpreadAimHint" Margin="0,10,0,0" Style="{StaticResource Subtext}" />

                                <Border Height="1" Background="{StaticResource CardBorder}" Margin="0,16,0,0" />

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Bloom while firing" Style="{StaticResource Subtext}"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="BloomValueText" Grid.Column="1" Text="0%"
                                               Style="{StaticResource Value}" MinWidth="76" />
                                </Grid>
                                <Slider x:Name="BloomSlider" Minimum="0" Maximum="100"
                                        TickFrequency="5" IsSnapToTickEnabled="True"
                                        Style="{StaticResource Slider}" VerticalAlignment="Center"
                                        ValueChanged="BloomSlider_ValueChanged" />
                                <DockPanel Margin="0,2,0,0">
                                    <TextBlock DockPanel.Dock="Right" Text="Never widens" Style="{StaticResource EndLabel}" />
                                    <TextBlock Text="Stock" Style="{StaticResource EndLabel}" />
                                </DockPanel>
                                <TextBlock x:Name="BloomHint" Margin="0,10,0,0" Style="{StaticResource Subtext}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                        <Grid x:Name="RecoilPanel">
                            <StackPanel>
                                <TextBlock Text="Weapon feel" Style="{StaticResource Section}" />
                                <TextBlock Text="How the gun itself moves. The camera keeps its own recoil."
                                           Style="{StaticResource Subtext}" Margin="0,3,0,0" />

                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Visual recoil" Style="{StaticResource Subtext}"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="RecoilValueText" Grid.Column="1" Text="100%"
                                               Style="{StaticResource Value}" MinWidth="76" />
                                </Grid>
                                <Slider x:Name="RecoilSlider" Minimum="0" Maximum="100"
                                        TickFrequency="5" IsSnapToTickEnabled="True"
                                        Style="{StaticResource Slider}" VerticalAlignment="Center"
                                        ValueChanged="RecoilSlider_ValueChanged" />
                                <DockPanel Margin="0,2,0,0">
                                    <TextBlock DockPanel.Dock="Right" Text="Stock" Style="{StaticResource EndLabel}" />
                                    <TextBlock Text="No kick" Style="{StaticResource EndLabel}" />
                                </DockPanel>
                                <TextBlock x:Name="RecoilHint" Margin="0,10,0,0" Style="{StaticResource Subtext}" />

                                <Border Height="1" Background="{StaticResource CardBorder}" Margin="0,16,0,0" />

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Weapon sway" Style="{StaticResource Subtext}"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="SwayValueText" Grid.Column="1" Text="100%"
                                               Style="{StaticResource Value}" MinWidth="76" />
                                </Grid>
                                <Slider x:Name="SwaySlider" Minimum="0" Maximum="100"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        Style="{StaticResource Slider}" VerticalAlignment="Center"
                                        ValueChanged="SwaySlider_ValueChanged" />
                                <DockPanel Margin="0,2,0,0">
                                    <TextBlock DockPanel.Dock="Right" Text="Stock" Style="{StaticResource EndLabel}" />
                                    <TextBlock Text="No drift" Style="{StaticResource EndLabel}" />
                                </DockPanel>
                                <TextBlock x:Name="SwayHint" Margin="0,10,0,0" Style="{StaticResource Subtext}" />

                                <Border Height="1" Background="{StaticResource CardBorder}" Margin="0,16,0,0" />

                                <DockPanel Margin="0,16,0,0">
                                    <CheckBox x:Name="FlashSwitch" DockPanel.Dock="Right" Content="On"
                                              Style="{StaticResource Switch}" VerticalAlignment="Center"
                                              Checked="Flash_Changed" Unchecked="Flash_Changed" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Hide muzzle flash" Style="{StaticResource Subtext}" />
                                        <TextBlock Text="The flash and the smoke puff when you fire."
                                                   Style="{StaticResource Subtext}" Opacity="0.7" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock x:Name="FlashHint" Margin="0,10,0,0" Style="{StaticResource Subtext}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!-- Viewmodel -->
            <ScrollViewer x:Name="PageViewmodel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <Grid x:Name="ViewmodelPanel">
                            <StackPanel>
                                <TextBlock Text="Viewmodel offsets" Style="{StaticResource Section}" />
                                <TextBlock Text="Moves the gun without moving the camera. All zero is stock."
                                           Style="{StaticResource Subtext}" Margin="0,3,0,0" />

                                <DockPanel Margin="0,14,0,0">
                                    <CheckBox x:Name="ViewmodelSwitch" DockPanel.Dock="Right" Content="On"
                                              Style="{StaticResource Switch}" VerticalAlignment="Center"
                                              Checked="Viewmodel_Changed" Unchecked="Viewmodel_Changed" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Apply offsets" Style="{StaticResource Subtext}" />
                                        <TextBlock Text="Off keeps your values and puts the gun back."
                                                   Style="{StaticResource Subtext}" Opacity="0.7" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>

                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Depth" Style="{StaticResource Subtext}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ViewmodelXValueText" Grid.Column="1" Text="0.0"
                                               Style="{StaticResource Value}" MinWidth="76" />
                                </Grid>
                                <Slider x:Name="ViewmodelXSlider" Minimum="-1.5" Maximum="3"
                                        TickFrequency="0.1" IsSnapToTickEnabled="True"
                                        Style="{StaticResource Slider}" VerticalAlignment="Center"
                                        ValueChanged="ViewmodelXSlider_ValueChanged" />
                                <DockPanel Margin="0,2,0,0">
                                    <TextBlock DockPanel.Dock="Right" Text="3.0 out" Style="{StaticResource EndLabel}" />
                                    <TextBlock Text="1.5 in" Style="{StaticResource EndLabel}" />
                                </DockPanel>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Side to side" Style="{StaticResource Subtext}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ViewmodelZValueText" Grid.Column="1" Text="0.0"
                                               Style="{StaticResource Value}" MinWidth="76" />
                                </Grid>
                                <Slider x:Name="ViewmodelZSlider" Minimum="-3" Maximum="3"
                                        TickFrequency="0.1" IsSnapToTickEnabled="True"
                                        Style="{StaticResource Slider}" VerticalAlignment="Center"
                                        ValueChanged="ViewmodelZSlider_ValueChanged" />
                                <DockPanel Margin="0,2,0,0">
                                    <TextBlock DockPanel.Dock="Right" Text="3.0 right" Style="{StaticResource EndLabel}" />
                                    <TextBlock Text="3.0 left" Style="{StaticResource EndLabel}" />
                                </DockPanel>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Up and down" Style="{StaticResource Subtext}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ViewmodelYValueText" Grid.Column="1" Text="0.0"
                                               Style="{StaticResource Value}" MinWidth="76" />
                                </Grid>
                                <Slider x:Name="ViewmodelYSlider" Minimum="-3" Maximum="3"
                                        TickFrequency="0.1" IsSnapToTickEnabled="True"
                                        Style="{StaticResource Slider}" VerticalAlignment="Center"
                                        ValueChanged="ViewmodelYSlider_ValueChanged" />
                                <DockPanel Margin="0,2,0,0">
                                    <TextBlock DockPanel.Dock="Right" Text="3.0 up" Style="{StaticResource EndLabel}" />
                                    <TextBlock Text="3.0 down" Style="{StaticResource EndLabel}" />
                                </DockPanel>

                                <TextBlock x:Name="ViewmodelHint" Margin="0,12,0,0" Style="{StaticResource Subtext}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Crosshair -->
            <ScrollViewer x:Name="PageCrosshair" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <Grid x:Name="CrosshairPanel">
                            <StackPanel>
                                <DockPanel>
                                    <CheckBox x:Name="CrosshairSwitch" DockPanel.Dock="Right" Content="On"
                                              Style="{StaticResource Switch}" VerticalAlignment="Center"
                                              Checked="Crosshair_Changed" Unchecked="Crosshair_Changed" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Crosshair" Style="{StaticResource Section}" />
                                        <TextBlock Text="Size, opacity and the shape you aim with."
                                                   Style="{StaticResource Subtext}" Opacity="0.7" Margin="0,3,0,0" />
                                    </StackPanel>
                                </DockPanel>

                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Style" Style="{StaticResource Subtext}" VerticalAlignment="Center"
                                               Margin="0,0,10,0" />
                                    <Button x:Name="StyleGameButton" Grid.Column="1" Content="Game" Margin="0,0,6,0"
                                            Padding="10,5" Click="CrosshairStyle_Click" />
                                    <Button x:Name="StyleSharpButton" Grid.Column="2" Content="Sharp" Margin="0,0,6,0"
                                            Padding="10,5" Click="CrosshairStyle_Click" />
                                    <Button x:Name="StyleHaloButton" Grid.Column="3" Content="Halo"
                                            Padding="10,5" Click="CrosshairStyle_Click" />
                                </Grid>
                                <TextBlock x:Name="CrosshairStyleHint" Margin="0,8,0,0" Style="{StaticResource Subtext}" />

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Size" Style="{StaticResource Subtext}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="CrosshairSizeValueText" Grid.Column="1" Text="100%"
                                               Style="{StaticResource Value}" MinWidth="76" />
                                </Grid>
                                <Slider x:Name="CrosshairSizeSlider" Minimum="50" Maximum="200"
                                        TickFrequency="5" IsSnapToTickEnabled="True"
                                        Style="{StaticResource Slider}" VerticalAlignment="Center"
                                        ValueChanged="CrosshairSizeSlider_ValueChanged" />
                                <DockPanel Margin="0,2,0,0">
                                    <TextBlock DockPanel.Dock="Right" Text="200%" Style="{StaticResource EndLabel}" />
                                    <TextBlock Text="50%" Style="{StaticResource EndLabel}" />
                                </DockPanel>
                                <TextBlock x:Name="CrosshairSizeHint" Margin="0,10,0,0" Style="{StaticResource Subtext}" />

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Opacity" Style="{StaticResource Subtext}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="CrosshairOpacityValueText" Grid.Column="1" Text="100%"
                                               Style="{StaticResource Value}" MinWidth="76" />
                                </Grid>
                                <Slider x:Name="CrosshairOpacitySlider" Minimum="0" Maximum="100"
                                        TickFrequency="5" IsSnapToTickEnabled="True"
                                        Style="{StaticResource Slider}" VerticalAlignment="Center"
                                        ValueChanged="CrosshairOpacitySlider_ValueChanged" />
                                <DockPanel Margin="0,2,0,0">
                                    <TextBlock DockPanel.Dock="Right" Text="Solid" Style="{StaticResource EndLabel}" />
                                    <TextBlock Text="Invisible" Style="{StaticResource EndLabel}" />
                                </DockPanel>

                                <Border Height="1" Background="{StaticResource CardBorder}" Margin="0,16,0,0" />

                                <DockPanel Margin="0,16,0,0">
                                    <CheckBox x:Name="CrosshairShowSwitch" DockPanel.Dock="Right" Content="On"
                                              Style="{StaticResource Switch}" VerticalAlignment="Center"
                                              Checked="CrosshairShow_Changed" Unchecked="CrosshairShow_Changed" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Draw the crosshair" Style="{StaticResource Subtext}" />
                                        <TextBlock Text="Turn it off for a clean screen."
                                                   Style="{StaticResource Subtext}" Opacity="0.7" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>

                                <DockPanel Margin="0,16,0,0">
                                    <CheckBox x:Name="CrosshairAlwaysShowSwitch" DockPanel.Dock="Right" Content="On"
                                              Style="{StaticResource Switch}" VerticalAlignment="Center"
                                              Checked="CrosshairAlwaysShow_Changed" Unchecked="CrosshairAlwaysShow_Changed" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Always show" Style="{StaticResource Subtext}" />
                                        <TextBlock Text="Keeps the Sharp or Halo crosshair visible while aiming down sights."
                                                   Style="{StaticResource Subtext}" Opacity="0.7" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>

                                <DockPanel Margin="0,16,0,0">
                                    <CheckBox x:Name="CrosshairDynamicSwitch" DockPanel.Dock="Right" Content="On"
                                              Style="{StaticResource Switch}" VerticalAlignment="Center"
                                              Checked="CrosshairDynamic_Changed" Unchecked="CrosshairDynamic_Changed" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Open with spread" Style="{StaticResource Subtext}" />
                                        <TextBlock Text="The crosshair parts as your cone widens. Game style only."
                                                   Style="{StaticResource Subtext}" Opacity="0.7" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Screen -->
            <ScrollViewer x:Name="PageScreen" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <Grid x:Name="FlinchPanel">
                            <StackPanel>
                                <TextBlock Text="Damage feedback" Style="{StaticResource Section}" />
                                <TextBlock Text="What happens to your view when a shot lands."
                                           Style="{StaticResource Subtext}" Margin="0,3,0,0" />

                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="View kick" Style="{StaticResource Subtext}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="FlinchValueText" Grid.Column="1" Text="100%"
                                               Style="{StaticResource Value}" MinWidth="76" />
                                </Grid>
                                <Slider x:Name="FlinchSlider" Minimum="0" Maximum="100"
                                        TickFrequency="5" IsSnapToTickEnabled="True"
                                        Style="{StaticResource Slider}" VerticalAlignment="Center"
                                        ValueChanged="FlinchSlider_ValueChanged" />
                                <DockPanel Margin="0,2,0,0">
                                    <TextBlock DockPanel.Dock="Right" Text="Stock" Style="{StaticResource EndLabel}" />
                                    <TextBlock Text="None" Style="{StaticResource EndLabel}" />
                                </DockPanel>
                                <TextBlock x:Name="FlinchHint" Margin="0,10,0,0" Style="{StaticResource Subtext}" />

                                <Border Height="1" Background="{StaticResource CardBorder}" Margin="0,16,0,0" />

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Screen blur" Style="{StaticResource Subtext}"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="BlurValueText" Grid.Column="1" Text="100%"
                                               Style="{StaticResource Value}" MinWidth="76" />
                                </Grid>
                                <Slider x:Name="BlurSlider" Minimum="0" Maximum="100"
                                        TickFrequency="5" IsSnapToTickEnabled="True"
                                        Style="{StaticResource Slider}" VerticalAlignment="Center"
                                        ValueChanged="BlurSlider_ValueChanged" />
                                <DockPanel Margin="0,2,0,0">
                                    <TextBlock DockPanel.Dock="Right" Text="Stock" Style="{StaticResource EndLabel}" />
                                    <TextBlock Text="None" Style="{StaticResource EndLabel}" />
                                </DockPanel>
                                <TextBlock x:Name="BlurHint" Margin="0,10,0,0" Style="{StaticResource Subtext}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Setup -->
            <ScrollViewer x:Name="PageSetup" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <CheckBox x:Name="IntroSwitch" DockPanel.Dock="Right" Content="Off"
                                          Style="{StaticResource Switch}" VerticalAlignment="Top"
                                          Margin="12,0,0,0" Checked="Intro_Changed" Unchecked="Intro_Changed" />
                                <StackPanel>
                                    <TextBlock Text="Skip intro" Style="{StaticResource Section}" />
                                    <TextBlock x:Name="IntroHint" Style="{StaticResource Subtext}" Margin="0,3,0,0"
                                               Text="Launch straight to the main menu." />
                                </StackPanel>
                            </DockPanel>

                            <TextBlock Margin="0,12,0,0" Style="{StaticResource Subtext}" Opacity="0.7"
                                       Text="The game reads this before its first frame, so close the game before changing it." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <Button x:Name="RuntimeButton" DockPanel.Dock="Right" Content="Install"
                                    Click="Runtime_Click" MinWidth="96" VerticalAlignment="Top"
                                    Margin="12,0,0,0" />
                            <StackPanel>
                                <TextBlock Text="Runtime" Style="{StaticResource Section}" />
                                <TextBlock x:Name="RuntimeDetail"
                                           Text="Adds X3DAudio1_7.dll to the game folder so the mod loads with the game."
                                           Style="{StaticResource Subtext}" Margin="0,3,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top"
                                            Margin="12,0,0,0">
                                    <Button x:Name="DxvkFileButton" Content="From file..." Click="DxvkFile_Click"
                                            Padding="11,4" Margin="0,0,8,0" />
                                    <Button x:Name="DxvkButton" Content="Install" Click="Dxvk_Click"
                                            MinWidth="96" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="DXVK" Style="{StaticResource Section}" />
                                    <TextBlock x:Name="DxvkDetail"
                                               Text="Optional. Renders the game through Vulkan instead of D3D9."
                                               Style="{StaticResource Subtext}" Margin="0,3,0,0" />
                                </StackPanel>
                            </DockPanel>

                            <TextBlock Margin="0,12,0,0" Style="{StaticResource Subtext}" Opacity="0.7"
                                       Text="The Steam overlay does not draw over Vulkan, and the game's own Direct3D effects may look different. Remove ReShade before installing DXVK; running both needs ReShade's Vulkan install." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top"
                                            Margin="12,0,0,0">
                                    <Button x:Name="D3d11FileButton" Content="From file..." Click="D3d11File_Click"
                                            Padding="11,4" Margin="0,0,8,0" />
                                    <Button x:Name="D3d11Button" Content="Install" Click="D3d11_Click"
                                            MinWidth="96" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Direct3D 11" Style="{StaticResource Section}" />
                                    <TextBlock x:Name="D3d11Detail"
                                               Text="Optional. Hands the game's Direct3D 9 calls to Direct3D 11 through dgVoodoo 2."
                                               Style="{StaticResource Subtext}" Margin="0,3,0,0" />
                                </StackPanel>
                            </DockPanel>

                            <TextBlock Margin="0,12,0,0" Style="{StaticResource Subtext}" Opacity="0.7"
                                       Text="Only one wrapper can own d3d9.dll, so this replaces DXVK. ReShade moves to dxgi.dll alongside it. Its settings live in dgVoodoo.conf. The game's own crosshair stays; the custom ones need Direct3D 9." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <Button x:Name="ReShadeButton" DockPanel.Dock="Right" Content="Install"
                                        Click="ReShade_Click" MinWidth="96" VerticalAlignment="Top"
                                        Margin="12,0,0,0" />
                                <StackPanel>
                                    <TextBlock Text="ReShade" Style="{StaticResource Section}" />
                                    <TextBlock x:Name="ReShadeDetail"
                                               Text="Optional. Adds ReShade with its presets and shader library."
                                               Style="{StaticResource Subtext}" Margin="0,3,0,0" />
                                </StackPanel>
                            </DockPanel>

                            <TextBlock Margin="0,12,0,0" Style="{StaticResource Subtext}" Opacity="0.7"
                                       Text="ReShade follows the renderer: native Direct3D 9 uses d3d9.dll, the Direct3D 11 wrapper uses dxgi.dll. It moves by itself when you add or remove the wrapper. Presets, shaders and ReShade.ini are included; existing files are kept. The overlay key is the one set in ReShade.ini." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Co-op tuning" Style="{StaticResource Section}" />
                            <TextBlock x:Name="CoopDetail"
                                       Text="Applies the community Survival settings to players2\config.cfg."
                                       Style="{StaticResource Subtext}" Margin="0,3,0,0" TextWrapping="Wrap" />

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="Frame cap" Style="{StaticResource Subtext}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox x:Name="CoopCapBox" Style="{StaticResource Dropdown}" Width="86"
                                          VerticalAlignment="Center" SelectedIndex="0">
                                    <ComboBoxItem Content="60 FPS" Tag="60" />
                                    <ComboBoxItem Content="120 FPS" Tag="120" />
                                </ComboBox>
                                <Button x:Name="CoopApplyButton" Content="Apply" Click="CoopApply_Click"
                                        MinWidth="84" Margin="10,0,0,0" />
                                <Button x:Name="CoopReadOnlyButton" Content="Make read-only"
                                        Click="CoopReadOnly_Click" MinWidth="126" Margin="8,0,0,0" />
                            </StackPanel>

                            <TextBlock Margin="0,10,0,0" Style="{StaticResource Subtext}" Opacity="0.7" TextWrapping="Wrap"
                                       Text="Close the game before applying; it rewrites config.cfg on exit. Both players should use the same cap. Read-only stops the game from changing these lines." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <Button x:Name="NetworkFixButton" DockPanel.Dock="Right" Content="Fix connection"
                                        Click="NetworkFix_Click" MinWidth="120" VerticalAlignment="Top"
                                        Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" />
                                <StackPanel>
                                    <TextBlock Text="Network" Style="{StaticResource Section}" />
                                    <TextBlock x:Name="NetworkDetail"
                                               Text="Survival co-op is peer-to-peer. Check the local side first: firewall, UPnP and CGNAT."
                                               Style="{StaticResource Subtext}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="NetworkCheckButton" Content="Check" Click="NetworkCheck_Click" MinWidth="84" />
                                <Button x:Name="NetworkCopyButton" Content="Copy report" Click="NetworkCopy_Click"
                                        MinWidth="104" Margin="8,0,0,0" />
                            </StackPanel>

                            <TextBlock x:Name="NetworkReport" Visibility="Collapsed"
                                       FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap"
                                       Margin="0,10,0,0" Foreground="{StaticResource Muted}" />

                            <TextBlock Margin="0,10,0,0" Style="{StaticResource Subtext}" Opacity="0.7" TextWrapping="Wrap"
                                       Text="Both players should run this. No local tool can open the other player's router or fix CGNAT. If the router has UPnP disabled, the ports need to be forwarded manually." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <Button x:Name="UpdateButton" DockPanel.Dock="Right" Content="Check now"
                                        Click="Update_Click" MinWidth="110" VerticalAlignment="Top"
                                        Margin="12,0,0,0" />
                                <StackPanel>
                                    <TextBlock Text="Updates" Style="{StaticResource Section}" />
                                    <TextBlock x:Name="UpdateDetail"
                                               Text="Check GitHub Releases for a newer version."
                                               Style="{StaticResource Subtext}" Margin="0,3,0,0" />
                                </StackPanel>
                            </DockPanel>

                            <DockPanel Margin="0,12,0,0">
                                <CheckBox x:Name="AutoUpdateSwitch" DockPanel.Dock="Right" Content="On"
                                          Style="{StaticResource Switch}" VerticalAlignment="Top"
                                          Margin="12,0,0,0" Checked="AutoUpdate_Changed"
                                          Unchecked="AutoUpdate_Changed" />
                                <StackPanel>
                                    <TextBlock Text="Check on launch" Style="{StaticResource Subtext}" />
                                    <TextBlock Text="Look for a newer release when the manager starts."
                                               Style="{StaticResource Subtext}" Opacity="0.7"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="About" Style="{StaticResource Section}" />
                            <TextBlock Margin="0,3,0,0" Style="{StaticResource Subtext}"
                                       Text="Settings are written to %LOCALAPPDATA%\MW3Mod\settings.ini and picked up by the game within a second. Nothing is applied until the runtime is installed." />
                            <TextBlock Margin="0,6,0,0" Style="{StaticResource Subtext}" Opacity="0.7"
                                       Text="Logs are written to %LOCALAPPDATA%\MW3Mod\Log. Share manager.log and runtime.log when reporting a problem." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="3" Background="#141719" Padding="24,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Logs" Click="OpenLog_Click" Padding="11,4" ToolTip="Open the log folder" />
                    <Button Content="Data folder" Click="OpenFolder_Click" Padding="11,4" Margin="8,0,0,0" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Text="Ready" Style="{StaticResource Subtext}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
